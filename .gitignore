# Agent-local settings (per-user, never shared)
.claude/settings.local.json

# Harness scratch state (per-checkout, written by ./agents.sh verify)
.agents/state/last_verify.json

# Python/cache noise
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments and local env files
.venv/
venv/
.env
.env.*

# Build/output directories common to projects created from this template
build/
dist/
coverage/
node_modules/
target/

# OS/editor noise
.DS_Store
.idea/
.vscode/
